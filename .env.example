# Supabase-Projekt "mywine"
NEXT_PUBLIC_SUPABASE_URL=https://ckwwttimhhogyzekvlad.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Öffentliche Basis-URL für den Magic-Link-Redirect (optional).
# Auf Vercel wird ohne diesen Wert der Host des Requests verwendet.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Monatsbudget der Claude-API in USD (Standard 20): darüber pausieren Hintergrund-Recherchen.
# Erhöhen für den laufenden Monat: Knopf auf /recherche (+10 USD).
API_MONTHLY_BUDGET_USD=20

# Preissuche über Google Shopping Schweiz (SerpApi, Gratis-Plan 250 Abfragen/Monat). Ohne
# Schlüssel bzw. bei erschöpftem Kontingent übernimmt die bisherige Preissuche.
SERPAPI_API_KEY=
# Zweiter Anbieter für Google Shopping: Serper (2'500 Gratis-Abfragen). Ohne SerpApi bzw. wenn
# dessen Kontingent erschöpft ist, wird Serper verwendet.
SERPER_API_KEY=
